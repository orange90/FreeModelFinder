{
  "name": "freemodelfinder",
  "version": "0.1.0-rc.3",
  "description": "Discover and route free LLM models through a local OpenAI, Anthropic and Gemini compatible gateway.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fmf": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orange90/FreeModelFinder.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/orange90/FreeModelFinder#readme",
  "bugs": {
    "url": "https://github.com/orange90/FreeModelFinder/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "api-gateway",
    "free-models"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:dependencies && tsup && node scripts/copy-assets.mjs",
    "build:dependencies": "pnpm --filter @freemodelfinder/ui build && pnpm --filter @freemodelfinder/core build && pnpm --filter @freemodelfinder/server build",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "test:coverage": "c8 --all --include='src/**/*.ts' --exclude='src/__tests__/**' --check-coverage --lines=80 node --import tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/clean.mjs && pnpm --workspace-root test && pnpm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "node scripts/deny-source-publish.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fastify": "5.10.0",
    "inquirer": "^9.2.16",
    "open": "11.0.0",
    "ora": "^8.0.1",
    "undici": "7.29.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@freemodelfinder/core": "workspace:*",
    "@freemodelfinder/server": "workspace:*",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.15.0",
    "c8": "10.1.3",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
