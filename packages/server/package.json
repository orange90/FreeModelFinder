{
  "name": "@freemodelfinder/server",
  "version": "0.1.0-rc.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "freemodelfinder-server": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --import ./src/__tests__/setup.mjs --test src/__tests__/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/__tests__/**' --test-coverage-lines=80 --test-coverage-branches=75 --import tsx --import ./src/__tests__/setup.mjs --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.2",
    "@freemodelfinder/core": "workspace:*",
    "fastify": "5.10.0",
    "undici": "7.29.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
